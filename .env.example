# ── Сервер ───────────────────────────────────────────────
NODE_ENV=development
PORT=3000
# Адрес фронтенда (CORS), через запятую
CORS_ORIGINS=http://localhost:5173
# Публичный адрес приложения (для ссылок в приглашениях и электронных чеках)
APP_PUBLIC_URL=http://localhost:5173

# ── База данных ──────────────────────────────────────────
# Роль приложения: БЕЗ BYPASSRLS, не владелец таблиц (см. scripts/init-db.sql)
DATABASE_URL=postgres://autoparts_app:app_password@localhost:5432/autoparts
# Роль-владелец: миграции, сиды, pg-boss
DATABASE_OWNER_URL=postgres://autoparts_owner:owner_password@localhost:5432/autoparts
DB_POOL_SIZE=20
DB_LOGGING=false

# ── Токены ───────────────────────────────────────────────
# Сгенерировать: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_ACCESS_SECRET=change_me_to_long_random_string
JWT_ACCESS_TTL=15m
REFRESH_TTL_DAYS=30
# true на сервере с HTTPS
COOKIE_SECURE=false
COOKIE_DOMAIN=

# Ключ шифрования секретов (2FA и т.п.), 32+ символа. НЕ менять после запуска.
ENCRYPTION_KEY=change_me_32_chars_minimum_random_key

# ── Файлы ────────────────────────────────────────────────
UPLOADS_DIR=uploads
MAX_UPLOAD_MB=10

# ── Прочее ───────────────────────────────────────────────
TOTP_ISSUER=AutopartsCRM
# Интервал обработчика outbox, мс
OUTBOX_POLL_MS=1000

# ── Прайсы поставщиков по ссылке ─────────────────────────
# true — разрешить ссылки на адреса локальной сети (только разработка)
PRICELIST_ALLOW_PRIVATE_URLS=false
# Распознавание номеров с фото: адрес ocr-service (пусто — выключено)
OCR_URL=
OCR_TIMEOUT_MS=15000
PRICELIST_MAX_MB=100

# Курсы НБКР (загружаются каждый день)
NBKR_URL=https://www.nbkr.kg/XML/daily.xml
# Telegram-бот платформы (пусто — выключен). Вебхук: npm run telegram:webhook
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=
TELEGRAM_WEBHOOK_SECRET=
TELEGRAM_API_URL=https://api.telegram.org
